PORT_BACK=
PORT_FRONT=
PORT_DB=
APP_NAME=

MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=

MONGO_EXPRESS_USERNAME=
MONGO_EXPRESS_PASSWORD=

MONGO_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongo:${PORT_DB}/${MONGO_DB}?authSource=admin

JWT_SECRET=


PASSWORD_PEPPER=

ARGON2_MEMORY_COST=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=

# Node environment: development | production | test
NODE_ENV=development

# Supabase storage (image uploads) — required by the /images route
SUPABASE_PROJECT_URL=
SUPABASE_KEY=

# Resend transactional email (account confirmation on signup).
# Leave RESEND_API_KEY blank to disable email sending (local dev / tests).
# MAIL_FROM must be a sender on a domain verified in your Resend account;
# if unset it falls back to Resend's shared onboarding@resend.dev sender.
RESEND_API_KEY=
MAIL_FROM=

# Frontend → backend API base URL (must end with a trailing slash).
# Falls back to http://localhost:5000/api/v1/ if unset — set it in prod.
NUXT_PUBLIC_API_URL=