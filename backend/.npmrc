# Render sets NODE_ENV=production, which makes `npm install`/`npm ci` omit
# devDependencies. The production build needs them (the `build` script runs
# `tsc`, and TypeScript + @types/* live in devDependencies), so force npm to
# install dev deps regardless of NODE_ENV. `include` wins over the implicit
# `omit=dev` triggered by NODE_ENV=production.
include=dev
